---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const categoryClass: Record<string, string> = {
  "Shopify public app": "border-accent/40 bg-accent/10 text-accent",
  "Public app contribution": "border-accent/40 bg-accent/10 text-accent",
  "Private application": "border-accent-secondary/40 bg-accent-secondary/10 text-accent-secondary",
  CRM: "border-border bg-surface text-muted",
};
---

{
  hasProjects && (
    <section id="projects" class="bg-surface px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
            Projects
          </h2>
          <div class="mt-4 h-1 w-16 rounded-full bg-accent" />
        </div>

        <div class="lg:col-span-8">
          <div class="space-y-5">
            {siteConfig.projects.map((project, index) => {
              const Component = project.link ? "a" : "div";
              const linkProps = project.link
                ? {
                    href: project.link,
                    target: "_blank",
                    rel: "noopener noreferrer",
                  }
                : {};
              const badgeClass = project.category
                ? categoryClass[project.category] || "border-border bg-surface text-muted"
                : "";

              return (
                <div class="group relative">
                  <Component
                    {...linkProps}
                    class:list={[
                      "block rounded-xl border border-border bg-card p-5 transition-all duration-300 sm:p-7",
                      project.link &&
                        "hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-lg hover:shadow-black/20",
                    ]}
                  >
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <p class="font-mono text-sm text-accent">
                          {String(index + 1).padStart(2, "0")}
                        </p>
                        {project.category && (
                          <span
                            class:list={[
                              "mt-3 inline-flex rounded-full border px-2.5 py-1 text-xs font-medium",
                              badgeClass,
                            ]}
                          >
                            {project.category}
                          </span>
                        )}
                        <h3 class="mt-2 text-xl font-semibold text-foreground sm:text-2xl">
                          {project.name}
                        </h3>
                      </div>
                      {project.link && (
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-border text-foreground transition-colors duration-300 group-hover:border-accent group-hover:text-accent">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                          </svg>
                        </span>
                      )}
                    </div>

                    <p class="mt-4 text-base leading-relaxed text-muted">{project.description}</p>

                    {project.skills && project.skills.length > 0 && (
                      <div class="mt-5 flex flex-wrap gap-2">
                        {project.skills.map((skill) => (
                          <span class="rounded-md border border-border bg-background px-2.5 py-1 text-xs text-foreground">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}
                  </Component>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
