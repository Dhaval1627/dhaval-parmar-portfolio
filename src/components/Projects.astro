---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const categoryClass: Record<string, string> = {
  "Shopify public app":
    "border-[#22C55E]/40 bg-[#22C55E]/10 text-[#22C55E]",
  "Public app contribution":
    "border-orange-400/40 bg-orange-400/10 text-orange-400",
  "Private application":
    "border-[#6366F1]/40 bg-[#6366F1]/10 text-[#6366F1]",
  CRM: "border-slate-500/40 bg-slate-500/10 text-slate-400",
};
---

{
  hasProjects && (
    <section
      id="projects"
      class="relative bg-[#0F172A] px-6 py-20 sm:px-10 lg:px-16 lg:py-28 overflow-hidden"
    >
      {/* Dot-grid pattern overlay */}
      <div
        class="pointer-events-none absolute inset-0 z-0"
        style="background-image: radial-gradient(circle, rgba(148,163,184,0.07) 1px, transparent 1px); background-size: 28px 28px;"
      />

      {/* Faint green glow top-left */}
      <div class="pointer-events-none absolute -top-32 -left-32 z-0 h-96 w-96 rounded-full bg-[#22C55E]/5 blur-3xl" />
      {/* Faint indigo glow bottom-right */}
      <div class="pointer-events-none absolute -bottom-32 -right-32 z-0 h-96 w-96 rounded-full bg-[#6366F1]/5 blur-3xl" />

      <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">

        {/* ── Left column heading ── */}
        <div class="lg:col-span-4 lg:sticky lg:top-28">
          <h2 class="font-mono text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
            Projects<span class="text-[#22C55E]">.</span>
          </h2>
          <div class="mt-4 h-1 w-16 rounded-full bg-[#22C55E]" />
          <p class="mt-6 text-base leading-relaxed text-slate-300">
            A selection of Shopify apps, Laravel platforms, and integrations built over{" "}
            <span class="font-mono font-medium text-[#22C55E]">4+ years</span>.
          </p>
        </div>

        {/* ── Project cards ── */}
        <div class="lg:col-span-8">
          <div class="space-y-6">
            {siteConfig.projects.map((project, index) => {
              const Component = project.link ? "a" : "div";
              const linkProps = project.link
                ? {
                    href: project.link,
                    target: "_blank",
                    rel: "noopener noreferrer",
                  }
                : {};
              const badgeClass = project.category
                ? categoryClass[project.category] ||
                  "border-slate-500/40 bg-slate-500/10 text-slate-400"
                : "";

              return (
                <div class="group relative">
                  <Component
                    {...linkProps}
                    class:list={[
                      "relative block overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0E1223]/80 backdrop-blur-xl p-6 sm:p-8 transition-all duration-300 hover:border-[#22C55E]/20 hover:shadow-lg hover:shadow-[#22C55E]/5",
                      project.link &&
                        "hover:-translate-y-1 hover:border-[#22C55E]/40 cursor-pointer",
                    ]}
                  >
                    {/* Top row: project number + optional arrow icon */}
                    <div class="flex items-start justify-between gap-4 mb-4">
                      <span class="font-mono text-xs font-semibold text-slate-400 tabular-nums select-none">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      {project.link && (
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#22C55E]/30 text-[#22C55E] transition-all duration-300 group-hover:border-[#22C55E] group-hover:bg-[#22C55E]/10 group-hover:shadow-[0_0_12px_rgba(34,197,94,0.3)]">
                          <span class="sr-only">(opens in new tab)</span>
                          <svg
                            class="h-3.5 w-3.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 17L17 7M17 7H7M17 7V17"
                            />
                          </svg>
                        </span>
                      )}
                    </div>

                    {/* Category badge */}
                    {project.category && (
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-2.5 py-0.5 font-mono text-xs font-medium tracking-wide mb-3",
                          badgeClass,
                        ]}
                      >
                        {project.category}
                      </span>
                    )}

                    {/* Project name */}
                    <h3 class="text-xl font-bold text-white sm:text-2xl leading-snug">
                      {project.name}
                    </h3>

                    {/* Description */}
                    <p class="mt-3 text-sm leading-relaxed text-[#94A3B8]">
                      {project.description}
                    </p>

                    {/* Tech tags */}
                    {project.skills && project.skills.length > 0 && (
                      <div class="mt-5 flex flex-wrap gap-2">
                        {project.skills.map((skill) => (
                          <span class="font-mono rounded-md border border-[#334155] bg-[#1E293B] px-2.5 py-1 text-xs text-[#94A3B8] transition-colors duration-200 group-hover:border-[#22C55E]/20">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Subtle bottom-left glow on hover */}
                    <div class="pointer-events-none absolute bottom-0 left-0 h-24 w-24 rounded-full bg-[#22C55E]/0 blur-2xl transition-all duration-500 group-hover:bg-[#22C55E]/5" />
                  </Component>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
