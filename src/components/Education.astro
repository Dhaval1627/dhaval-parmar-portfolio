---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="relative bg-[#0F172A] px-6 py-20 sm:px-10 lg:px-16 lg:py-28 overflow-hidden">
      {/* Faint green glow blob top-left */}
      <div
        class="pointer-events-none absolute top-0 left-0 h-[400px] w-[400px] rounded-full opacity-5 blur-[100px]"
        style="background: radial-gradient(circle, #22C55E 0%, transparent 70%);"
        aria-hidden="true"
      />

      <div class="relative mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
        {/* Left column heading */}
        <div class="lg:col-span-4">
          <h2 class="font-mono text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
            Education<span class="text-[#22C55E]">.</span>
          </h2>
          <div class="mt-4 h-1 w-16 rounded-full bg-[#22C55E]" />
          <p class="mt-6 text-base leading-relaxed text-slate-300">
            Academic foundations that underpin professional expertise in software development and computing.
          </p>
        </div>

        {/* Timeline */}
        <div class="lg:col-span-8">
          <ol
            class="relative space-y-8 pl-8"
            style="border-left: 2px solid; border-image: linear-gradient(to bottom, #22C55E, transparent) 1;"
          >
            {siteConfig.education.map((edu) => (
              <li class="relative">
                {/* Pulse dot marker */}
                <span class="absolute top-6 -left-[2.5rem] flex items-center justify-center" aria-hidden="true">
                  <span class="absolute inline-flex h-4 w-4 animate-ping rounded-full bg-[#22C55E] opacity-30" />
                  <span
                    class="relative inline-flex h-4 w-4 rounded-full border border-[#22C55E]/40"
                    style="background: linear-gradient(135deg, #22C55E, #16A34A);"
                  />
                </span>

                {/* Card */}
                <article class="group rounded-2xl border border-white/[0.08] bg-[#0E1223]/80 p-6 backdrop-blur-xl transition-all duration-300 hover:border-[#22C55E]/20 hover:shadow-lg hover:shadow-[#22C55E]/5">
                  {/* Card header */}
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="text-lg font-bold text-white sm:text-xl">{edu.degree}</h3>
                      <p class="mt-1 text-base font-semibold text-[#22C55E]">{edu.school}</p>
                    </div>
                    {/* Year / dateRange in mono */}
                    <div class="flex shrink-0 items-center gap-1.5 font-mono text-xs text-[#94A3B8]">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3.5 w-3.5 text-[#22C55E]/60"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        aria-hidden="true"
                      >
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                      </svg>
                      <span>{edu.dateRange}</span>
                    </div>
                  </div>

                  {/* Achievements with star SVG prefix */}
                  {edu.achievements && edu.achievements.length > 0 && (
                    <ul class="mt-4 space-y-2.5">
                      {edu.achievements.map((achievement) => (
                        <li class="flex items-start gap-2.5 text-sm leading-relaxed text-slate-300 sm:text-base">
                          {/* Star icon */}
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#22C55E]"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                          </svg>
                          <span>{achievement}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
