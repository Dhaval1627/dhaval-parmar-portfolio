---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="bg-background px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
            Experience
          </h2>
          <div class="mt-4 h-1 w-16 rounded-full bg-accent" />
        </div>

        <div class="lg:col-span-8">
          <ol class="relative space-y-8 border-l border-border pl-8">
            {siteConfig.experience.map((exp) => (
              <li class="relative">
                <span
                  class="absolute top-6 -left-[2.4rem] h-3 w-3 rounded-full border-2 border-accent bg-background"
                  aria-hidden="true"
                />
                <article class="rounded-xl border border-border bg-card p-5 transition-colors duration-300 hover:border-accent/40 sm:p-6">
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="text-lg font-semibold text-foreground sm:text-xl">{exp.title}</h3>
                      <p class="mt-1 text-base text-accent">{exp.company}</p>
                    </div>
                    <p class="text-sm text-muted sm:shrink-0">{exp.dateRange}</p>
                  </div>
                  <ul class="mt-4 space-y-2">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start gap-3 text-sm leading-relaxed text-muted sm:text-base">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}
