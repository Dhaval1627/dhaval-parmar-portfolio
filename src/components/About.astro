---
import { siteConfig } from "../config";

const skillGroups = Object.entries(siteConfig.skills);
---

<section
  id="about"
  class="relative overflow-hidden bg-[#020617] px-6 py-20 sm:px-10 lg:px-16 lg:py-28"
>
  {/* Radial gradient glow — top-right corner accent */}
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[480px] w-[480px] rounded-full bg-[#22C55E]/[0.06] blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-0 left-0 h-64 w-64 rounded-full bg-[#6366F1]/[0.05] blur-2xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">

    {/* ── Left column: section heading ── */}
    <div class="relative flex items-start gap-4 lg:col-span-4">
      {/* Vertical decorative line */}
      <div
        class="mt-2 hidden h-full w-px flex-shrink-0 bg-gradient-to-b from-[#22C55E]/60 via-[#22C55E]/20 to-transparent lg:block"
        aria-hidden="true"
      ></div>

      <div>
        {/* Section title */}
        <h2 class="font-mono text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
          About<span class="text-[#22C55E]">.</span>
        </h2>

        {/* Green accent underline */}
        <div class="mt-4 h-1 w-16 rounded-full bg-[#22C55E]"></div>
      </div>
    </div>

    {/* ── Right column: bio + skills ── */}
    <div class="space-y-10 lg:col-span-8">

      {/* About text */}
      <p class="font-sans text-lg leading-relaxed text-slate-300 sm:text-xl">
        {siteConfig.aboutMe}
      </p>

      {/* Skill groups */}
      {
        skillGroups.length > 0 && (
          <div class="space-y-5">
            {skillGroups.map(([group, items]) => (
              <div class="rounded-2xl border border-white/[0.08] bg-white/5 p-6 backdrop-blur-xl transition-colors duration-300 hover:border-white/[0.14]">
                {/* Category label */}
                <h3 class="mb-4 font-mono text-xs font-semibold uppercase tracking-widest text-[#22C55E]">
                  {group}
                </h3>

                {/* Skill pill badges */}
                <div class="flex flex-wrap gap-2">
                  {items.map((skill) => (
                    <span class="cursor-default rounded-full border border-[#334155] bg-[#1E293B] px-3.5 py-1.5 font-sans text-sm text-slate-300 transition-all duration-200 hover:border-[#22C55E]/60 hover:text-[#22C55E]">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      }

    </div>
  </div>
</section>
