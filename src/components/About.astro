---
import { siteConfig } from "../config";

const skillGroups = Object.entries(siteConfig.skills);
---

<section id="about" class="bg-background px-6 py-20 sm:px-10 lg:px-16 lg:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl md:text-5xl">
        About
      </h2>
      <div class="mt-4 h-1 w-16 rounded-full bg-accent"></div>
    </div>

    <div class="space-y-10 lg:col-span-8">
      <p class="text-lg leading-relaxed text-muted sm:text-xl">
        {siteConfig.aboutMe}
      </p>

      {
        skillGroups.length > 0 && (
          <div class="space-y-8">
            {skillGroups.map(([group, items]) => (
              <div>
                <h3 class="text-sm font-medium tracking-wide text-accent">{group}</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {items.map((skill) => (
                    <span class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-foreground transition-colors duration-300 hover:border-accent/60">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
