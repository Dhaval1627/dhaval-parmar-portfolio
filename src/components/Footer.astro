---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const links = [
  { href: "#about", label: "About" },
  ...(hasProjects ? [{ href: "#projects", label: "Projects" }] : []),
  ...(hasExperience ? [{ href: "#experience", label: "Experience" }] : []),
  ...(hasEducation ? [{ href: "#education", label: "Education" }] : []),
];
---

<footer class="relative border-t border-white/[0.08] bg-[#0F172A]/90 backdrop-blur">
  <!-- Green gradient divider line at top -->
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(to right, transparent, #22C55E, transparent);"
    aria-hidden="true"
  ></div>

  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:px-10 md:flex-row md:items-end md:justify-between">
    <!-- Left side: name, title, socials -->
    <div class="flex flex-col gap-4">
      <div>
        <p
          class="text-xl font-bold text-[#F8FAFC]"
          style="font-family: 'JetBrains Mono', monospace;"
        >
          {siteConfig.name}
        </p>
        <p class="mt-1 text-sm text-slate-300">{siteConfig.title}</p>
      </div>

      <!-- Social icons with accessible touch targets (>= 40px bounding box) -->
      <div class="flex gap-3 text-slate-300">
        {
          siteConfig.social?.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email Dhaval"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.03] transition-all duration-300 hover:border-[#22C55E]/40 hover:text-[#22C55E]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.phone && (
            <a
              href={`tel:${siteConfig.social.phone}`}
              aria-label="Call Dhaval"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.03] transition-all duration-300 hover:border-[#22C55E]/40 hover:text-[#22C55E]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.03] transition-all duration-300 hover:border-[#22C55E]/40 hover:text-[#22C55E]"
            >
              <span class="sr-only">(opens in new tab)</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.twitter && (
            <a
              href={siteConfig.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter profile"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.03] transition-all duration-300 hover:border-[#22C55E]/40 hover:text-[#22C55E]"
            >
              <span class="sr-only">(opens in new tab)</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
              </svg>
            </a>
          )
        }
        {
          siteConfig.social?.github && (
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub profile"
              class="social-icon inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/[0.06] bg-white/[0.03] transition-all duration-300 hover:border-[#22C55E]/40 hover:text-[#22C55E]"
            >
              <span class="sr-only">(opens in new tab)</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <!-- Right side: nav links + copyright -->
    <div class="flex flex-col gap-4 md:items-end">
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
        {
          links.map((link) => (
            <a href={link.href} class="text-sm text-slate-300 transition-colors duration-300 hover:text-[#22C55E]">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="text-sm text-slate-400">
        © {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
      </p>
      <!-- Built with note (high contrast >= 4.5:1) -->
      <p class="text-xs text-slate-400 font-mono">
        Built with <span class="text-[#22C55E]">Astro</span> &amp; <span class="text-[#818CF8]">Tailwind</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .social-icon:hover {
    filter: drop-shadow(0 0 8px rgba(34, 197, 94, 0.5));
  }
</style>